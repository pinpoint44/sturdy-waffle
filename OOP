    private void bOkActionPerformed(java.awt.event.ActionEvent evt) {                                    
        
        jFerrero.setEnabled(false);
        jKitkatGreen.setEnabled(false);
        jSnickers.setEnabled(false);
        jToblerone.setEnabled(false);
        jCadbury.setEnabled(false);
        jCloud9.setEnabled(false);
        jHershey.setEnabled(false);
        jChocoMucho.setEnabled(false);
        jGoya.setEnabled(false);
        jMandM.setEnabled(false);
        
        String StrCash=jTextFieldCash.getText();
           Cash = Double.parseDouble(StrCash);
           
           
           if (jTextFieldCash.getText().equals("0")  || jTextFieldCash.getText().equals("")){
            JOptionPane.showMessageDialog(null,"No Cash Tendered");
             bNext.setEnabled(false);
        }
        else {
           
           if (Cash >= totalCost) {
               Change = Cash - totalCost;
               jTextFieldChange.setText(String.format("%.0f", Change));
               
               recordSale();
               JOptionPane.showMessageDialog(null, "Sale Recorded Successfully!");
               bNext.setEnabled(true);
               bCancel.setEnabled(false);
           }
           
           else {
               JOptionPane.showMessageDialog(null,"Insufficient Cash");
               jTextFieldCash.setText("0");
               Cash =0.00;
               bNext.setEnabled(false);
           }
         }
    }                                   

